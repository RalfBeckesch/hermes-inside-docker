# =============================================================================
# .env.example – Environment variables for docker compose
# =============================================================================
# Copy to .env and adjust:
#   cp .env.example .env
# =============================================================================

# Hermes server port (default: 8080)
HERMES_PORT=8080

# ---------------------------------------------------------------------------
# UID/GID of your host user – files written by the container will belong to
# you instead of UID 10000 (the container's hermes user).
# Set to your host UID:
#   PUID=$(id -u)
#   PGID=$(id -g)
# ---------------------------------------------------------------------------
# PUID=1000
# PGID=1000

# ---------------------------------------------------------------------------
# Volume paths – all configurable via .env.
# ---------------------------------------------------------------------------
# Persistent configuration (config.yaml + .env)
# HERMES_CONFIG_DIR=./hermes-config

# Read-only input data
# INPUT_DIR=./input

# Read-write working directory
# WORKSPACE_DIR=./workspace

# Optional: Obsidian vault path. Only set when needed.
# When unset, a dummy directory ./vault-not-configured is created.
# VAULT_DIR=/path/to/your/vault

# ---------------------------------------------------------------------------
# (Optional) Comma-separated list of profiles for multi-profile mode
# ---------------------------------------------------------------------------
# HERMES_PROFILES=work,personal